# Names only. Real values live in Vercel env vars; `vercel env pull` writes them to .env.local.
VERCEL_OIDC_TOKEN=        # short-lived; used by Sandbox, AI Gateway and Vercel Connect
DATABASE_URL=             # added by the Neon Marketplace integration
RUN_NOW_SECRET=           # bearer secret for POST /api/run-now
CRON_SECRET=              # Vercel Cron sends it as a bearer token to /api/cron/daily
SLACK_ALERTS_CHANNEL_ID=  # channel for the daily summary (not a secret)
SALESFORCE_USERNAME=      # integration user for the JWT bearer flow (not a secret)
BASETEN_API_KEY=          # email drafts on Baseten (secret; set in Vercel, never in code)

# Optional overrides. Salesforce and Slack tokens come from Vercel Connect, not env vars.
# SALESFORCE_CONNECTOR=salesforce/signal-gen-sf
# SLACK_CONNECTOR=slack/signal-gen-slack
# Fallback only (External Client App, client-credentials flow):
# SALESFORCE_LOGIN_URL=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
